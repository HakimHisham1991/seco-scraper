@page
@model IndexModel
@{
    ViewData["Title"] = "Seco Item Description Harvester";
}

<div class="container py-4">
    <header class="mb-4">
        <h1 class="h3 mb-1">Seco Item Number → Item Description</h1>
        <p class="text-muted mb-1">v1.0.6</p>
        <p class="text-muted mb-0">
            Upload or paste Seco item numbers. DeepSeek browses product pages first; local HTML scraping is used as fallback.
            Refreshing this page starts a new session (all previous results are cleared automatically).
        </p>
    </header>

    <section class="card mb-4">
        <div class="card-header">Dashboard</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2"><strong>Total:</strong> <span id="statTotal">0</span></div>
                <div class="col-md-2"><strong>Pending:</strong> <span id="statPending">0</span></div>
                <div class="col-md-2"><strong>Processing:</strong> <span id="statProcessing">0</span></div>
                <div class="col-md-2"><strong>Completed:</strong> <span id="statCompleted">0</span></div>
                <div class="col-md-2"><strong>Failed:</strong> <span id="statFailed">0</span></div>
                <div class="col-md-4"><strong>Elapsed Time:</strong> <span id="progressElapsed">00:00:00</span></div>
            </div>
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header">Input</div>
        <div class="card-body">
            <label for="itemInput" class="form-label">Paste Item Numbers</label>
            <textarea id="itemInput" class="form-control font-monospace" rows="10" placeholder="02679365&#10;02679366&#10;02679367"></textarea>
            <div class="mt-3">
                <label for="csvFile" class="form-label">Or upload CSV</label>
                <input id="csvFile" type="file" class="form-control" accept=".csv,text/csv" />
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button id="uploadBtn" type="button" class="btn btn-primary">Upload List</button>
                <button id="uploadCsvBtn" type="button" class="btn btn-outline-primary">Upload CSV</button>
                <button id="startBtn" type="button" class="btn btn-success">Start Processing</button>
                <button id="retryBtn" type="button" class="btn btn-outline-secondary">Retry Failed</button>
                <button id="exportBtn" type="button" class="btn btn-outline-success">Export CSV</button>
                <button id="clearResultsBtn" type="button" class="btn btn-outline-danger">Clear Results</button>
                <button id="clearBtn" type="button" class="btn btn-outline-secondary">Clear Input</button>
            </div>
            <div id="statusMessage" class="alert alert-info mt-3 d-none" role="status"></div>
        </div>
    </section>

    <section class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Results</span>
            <input id="filterInput" type="search" class="form-control form-control-sm" placeholder="Filter results..." style="min-width: 220px;" />
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="resultsTable">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Item Number</th>
                            <th>Designation</th>
                            <th>Status</th>
                            <th>Updated (UTC)</th>
                        </tr>
                    </thead>
                    <tbody id="resultsBody"></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
