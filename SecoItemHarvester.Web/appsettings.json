{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=seco-harvester.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DeepSeek": {
    "BaseUrl": "http://localhost:11434",
    "ApiKey": "",
    "Model": "deepseek-r1",
    "TimeoutSeconds": 120,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 1000,
    "Enabled": true,
    "UseOpenAiCompatibleApi": false
  },
  "Processing": {
    "BatchSize": 20,
    "MaxConcurrency": 5,
    "RetryCount": 3,
    "HttpTimeoutSeconds": 45,
    "WorkerPollIntervalMilliseconds": 2000,
    "RateLimitPerSecond": 10
  }
}
